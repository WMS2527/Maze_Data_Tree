class Node:
    def __init__(self, data):
        self.left = None
        self.right = None
        self.data = data


# --- Maze Helper Functions ---


def encode(row, col):
    #Converts (row, col) to a unique ID from 0 to 35.
    return (row * 6) + col


def decode(val):
    #Converts a unique ID back to a readable (row, col) tuple.
    return (val // 6, val % 6)


def build_physical_maze():
    # Create all grid cells first
    nodes = {encode(r, c): Node(encode(r, c)) for r in range(6) for c in range(6)}
   
    # Trace the physical paths from your drawing image and link left/right manually
    def link(parent_rc, left_rc=None, right_rc=None):
        p = nodes[encode(*parent_rc)]
        if left_rc:   p.left = nodes[encode(*left_rc)]
        if right_rc:  p.right = nodes[encode(*right_rc)]


    # Main column 0 pathway going down
    link((0,0), left_rc=(1,0))
    link((1,0), left_rc=(2,0))
    link((2,0), left_rc=(3,0))
    link((3,0), left_rc=(4,0))
   
    # Junction at (4,0): can go to bottom dead-end (5,0) or turn right into (4,1)
    link((4,0), left_rc=(5,0), right_rc=(4,1))
    link((5,0), left_rc=(5,1))  # (5,1) is a dead end
   
    # Path moving back up through Column 1
    link((4,1), left_rc=(3,1))
    link((3,1), left_rc=(2,1))
    link((2,1), left_rc=(1,1))
    link((1,1), left_rc=(0,1))
   
    # (0,1) splits into the central loops or alternative branches
    link((0,1), left_rc=(2,2))
   
    # Central loop structures
    link((2,2), left_rc=(3,2))
    link((3,2), left_rc=(4,2))
    link((4,2), left_rc=(5,2))
    link((5,2), left_rc=(5,3))
    link((5,3), left_rc=(4,3))
    link((4,3), left_rc=(3,3))
   
    # Path crossing over to Column 4
    link((3,3), left_rc=(5,4))
    link((5,4), left_rc=(4,4))
    link((4,4), left_rc=(3,4))
    link((3,4), left_rc=(2,4))
    link((2,4), left_rc=(1,4))
   
    # Sharp turn at (1,4) splits into the top-right dead ends OR down to column 5
    link((1,4), left_rc=(1,5), right_rc=(2,5))
    link((1,5), left_rc=(0,5))  # (0,5) is a dead end
   
    # Column 5 path dropping down to the outer loop
    link((2,5), left_rc=(3,5))
    link((3,5), left_rc=(4,5))
    link((4,5), left_rc=(5,5))
   
    # Outer path loops back around toward the final corridor sequence
    link((5,5), left_rc=(1,3))
   
    # Final corridor sequence pathing
    link((1,3), left_rc=(1,2))
    link((1,2), left_rc=(0,2))
    link((0,2), left_rc=(0,3))  # (0,3) is the final leaf node
   
    return nodes[encode(0,0)]


def print_tree_formatted(node, depth=0, branch_type="C"):
    if node is None:
        return


    coord = decode(node.data)
    dashes = "-" * depth
   
    # Status flags (only tracking whether a path ends completely)
    status = ""
    if node.left is None and node.right is None:
        status = " DEAD END"


    print(f"{dashes}{coord} ({branch_type}){status}")


    # Display child branches
    if node.left:
        print_tree_formatted(node.left, depth + 1, "L")
    if node.right:
        print_tree_formatted(node.right, depth + 1, "R")


# --- Execute Program ---
if __name__ == "__main__":
    maze_root = build_physical_maze()
    print_tree_formatted(maze_root)
