class TreeNode:
    def __init__(self, coord, action, status=None):

        self.coord = coord
        self.action = action
        self.status = status
        self.children = []

    def add_child(self, child_node):
        """Adds a subsequent movement/step to this node."""
        self.children.append(child_node)

def print_tree_paths(node, current_path=None):
    """
    Finds all paths from the root to the leaf nodes
    and prints them with the specific dash indentation format.
    """
    if current_path is None:
        current_path = []

    # Append current node to the tracking path
    current_path.append(node)

    # If it's a leaf node (no more children), print the entire path accumulated so far
    if not node.children:
        for depth, path_node in enumerate(current_path):
            # Calculate the prefix dashes (4 dashes per level of depth)
            indentation = "-" * (depth * 4)
           
            # Format the coordinates and the action label
            if path_node.action == "START":
                line = f"{indentation}{path_node.coord[0]},{path_node.coord[1]} START"
            else:
                line = f"{indentation}{path_node.coord[0]},{path_node.coord[1]} ({path_node.action})"
           
            # Append terminal status if it exists
            if path_node.status:
                line += f" {path_node.status}"
               
            print(line)
        print()  # Empty line separator between distinct paths
    else:
        # Otherwise, continue depth-first traversal through all child branches
        for child in node.children:
            print_tree_paths(child, list(current_path))

# --- Demonstration & Tree Construction ---
if __name__ == "__main__":
    # 1. Create the root node
    root = TreeNode((0, 0), "START")

    # 2. Build Path 1 (Shared common ancestors up to 4,1)
    n1 = TreeNode((1, 0), "S")
    n2 = TreeNode((2, 0), "S")
    n3 = TreeNode((3, 0), "S")
    n4 = TreeNode((4, 0), "S")
    n5 = TreeNode((4, 1), "L")
    n6 = TreeNode((4, 2), "S")

    # Connect the main trunk
    root.add_child(n1)
    n1.add_child(n2)
    n2.add_child(n3)
    n3.add_child(n4)
    n4.add_child(n5)
    n5.add_child(n6)

    # Branch A: Leads to the first DEAD END
    branch_a1 = TreeNode((5, 2), "R")
    branch_a2 = TreeNode((5, 1), "R")
    branch_a3 = TreeNode((5, 0), "S", status="DEAD END")
    n6.add_child(branch_a1)
    branch_a1.add_child(branch_a2)
    branch_a2.add_child(branch_a3)

    # Branch B: Leads to the second DEAD END
    branch_b1 = TreeNode((3, 2), "L")
    branch_b2 = TreeNode((3, 1), "L")
    branch_b3 = TreeNode((2, 1), "R")
    branch_b4 = TreeNode((0, 1), "S", status="DEAD END")
    n6.add_child(branch_b1)
    branch_b1.add_child(branch_b2)
    branch_b2.add_child(branch_b3)
    branch_b3.add_child(branch_b4)

    # Branch C: Leads to the FINISH
    branch_c1 = TreeNode((2, 2), "S")
    branch_c2 = TreeNode((2, 3), "R")
    branch_c3 = TreeNode((1, 3), "S")
    branch_c4 = TreeNode((0, 3), "R")
    branch_c5 = TreeNode((0, 4), "L")
    branch_c6 = TreeNode((0, 5), "S", status="FINISH")
    branch_b1.add_child(branch_c1)  # Splits off from (3,2)
    branch_c1.add_child(branch_c2)
    branch_c2.add_child(branch_c3)
    branch_c3.add_child(branch_c4)
    branch_c4.add_child(branch_c5)
    branch_c5.add_child(branch_c6)

    Print the generated tree structures
    print_tree_paths(root)
